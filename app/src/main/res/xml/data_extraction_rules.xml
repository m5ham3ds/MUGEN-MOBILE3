<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="gemini_secure_key.dat" />
        <exclude domain="no_backup" path="gemini_secure_key.dat" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="gemini_secure_key.dat" />
        <exclude domain="no_backup" path="gemini_secure_key.dat" />
    </device-transfer>
</data-extraction-rules>
